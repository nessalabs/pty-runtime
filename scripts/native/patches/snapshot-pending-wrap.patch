+test "stream: continuation trims a completed sequence before a C1 introducer" {
+    // An unfinished APC string is the one committed-exit state that keeps
+    // the "anywhere" C1 transitions, so a C1 introducer there both ends it
+    // and opens a new sequence. Replay must open the new sequence only, and
+    // from ground that needs the introducer's seven-bit spelling.
+    const Case = struct {
+        input: []const u8,
+        expected: []const u8,
+    };
+    const cases = [_]Case{
+        .{ .input = "\x1b_apc\x90qdata", .expected = "\x1bPqdata" },
+        .{ .input = "\x1b_apc\x9b12;", .expected = "\x1b[12;" },
+        .{ .input = "\x1b_apc\x9d2;title", .expected = "\x1b]2;title" },
+        // The same trimming applies when ESC opened the abandoned string.
+        .{ .input = "\x1b_apc\x1b_next", .expected = "\x1b_next" },
+    };
+
+    const S = Stream(ContinuationTestHandler);
+    for (cases) |case| {
+        var stream = S.init(.{
+            .allocator = testing.allocator,
+            .handler = .{},
+            .continuation_max_bytes = 1024,
+        });
+        defer stream.deinit();
+        stream.nextSlice(case.input);
+
+        var buf: [1024]u8 = undefined;
+        var writer: std.Io.Writer = .fixed(&buf);
+        try stream.writeContinuation(&writer);
+        try testing.expectEqualStrings(case.expected, writer.buffered());
+
+        // The exported suffix is a valid continuation and re-exports itself.
+        try continuationpkg.validate(writer.buffered());
+
+        var restored = S.init(.{
+            .allocator = testing.allocator,
+            .handler = .{},
+            .continuation_max_bytes = 1024,
+        });
+        defer restored.deinit();
+        restored.nextSlice(writer.buffered());
+        var again: [1024]u8 = undefined;
+        var again_writer: std.Io.Writer = .fixed(&again);
+        try restored.writeContinuation(&again_writer);
+        try testing.expectEqualStrings(
+            case.expected,
+            again_writer.buffered(),
+        );
+    }
+}
