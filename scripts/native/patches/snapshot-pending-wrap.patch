+test "BitmapAllocator capacity rejection preserves allocations and retry" {
+    const testing = std.testing;
+    const Alloc = BitmapAllocator(1);
+    const layout = Alloc.layout(192);
+    const buf = try testing.allocator.alignedAlloc(u8, Alloc.base_align, layout.total_size);
+    defer testing.allocator.free(buf);
+    var allocator = Alloc.init(.init(buf), layout);
+    // Force search_start past a fully occupied word, then end exactly at capacity.
+    const prefix = try allocator.alloc(u8, buf, 64);
+    @memset(prefix, 0x5a);
+    for (1..65) |extra| {
+        try testing.expectError(error.OutOfMemory, allocator.alloc(u8, buf, 128 + extra));
+        try testing.expectEqual(@as(usize, 64), allocator.usedBytes(buf));
+        try testing.expectEqual(@as(usize, 1), allocator.search_start);
+        for (prefix) |byte| try testing.expectEqual(@as(u8, 0x5a), byte);
+    }
+    const remainder = try allocator.alloc(u8, buf, 128);
+    @memset(remainder, 0xa5);
+    try testing.expectEqual(@as(usize, 192), allocator.usedBytes(buf));
+    try testing.expectError(error.OutOfMemory, allocator.alloc(u8, buf, 1));
+    allocator.free(buf, remainder);
+    allocator.free(buf, prefix);
+    try testing.expectEqual(@as(usize, 0), allocator.usedBytes(buf));
+    const full = try allocator.alloc(u8, buf, 192);
+    @memset(full, 0x33);
+    try testing.expectEqual(@as(usize, 192), full.len);
+    allocator.free(buf, full);
+    try testing.expectEqual(@as(usize, 0), allocator.usedBytes(buf));
+}
